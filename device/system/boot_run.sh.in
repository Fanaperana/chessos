#!/bin/bash
# Started by systemd (ports boot mode) right before EmulationStation.
GAMEDIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$GAMEDIR" || exit 0
export APPLIANCE_DEVICE=1 @ENV@_DEVICE=1
export HOME="${HOME:-/home/ark}"
export SDL_GAMECONTROLLERCONFIG_FILE="$GAMEDIR/assets/gamecontrollerdb.txt"
if [ -x "$GAMEDIR/start" ]; then "$GAMEDIR/start"; else python3 main.py; fi > "$GAMEDIR/boot_log.txt" 2>&1
exit 0
